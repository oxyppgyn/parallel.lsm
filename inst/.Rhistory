getwd()
getwd()
?system.file
rstudioapi::getActiveDocumentContext()$path
rstudioapi::getActiveDocumentContext()$path |> dirname() |> dirname()
file.path(rstudioapi::getActiveDocumentContext()$path |> dirname() |> dirname(), 'R/lsm-funcs.R')
#SCRIPT TO CREATE ALL parallel.*() VARIATIONS OF FUNCTIONS
#Example format for sample_lsm() function
# parallel.sample_lsm <- function(..., split_on) {
#   result <- format_args(..., split_on = split_on, func = landscapemetrics::sample_lsm)
#   return(result)
# }
library(landscapemetrics)
#TXT/R File to Write Functions To
output_file <- file.path(rstudioapi::getActiveDocumentContext()$path |> dirname() |> dirname(), 'R/lsm-funcs.R')
#Text to Include at the Top of the File
file_top <- "#This file is automatically generated using create-lsm-funcs.R
#' @include parallel-lsm.R
#' @noRd
NULL
"
#Functions/Objects to Exclude
exclude <- c(
'lsm_abbreviations_names', 'landscape', 'augusta_nlcd', 'podlasie_ccilc',
'options_landscapemetrics', 'show_patches', 'show_cores', 'show_correlation', 'show_lsm'
)
#Function to Concat. The Formatting
func_format <- function(func) {paste0(
"#' @rdname parallel.lsm
#' @export
parallel.", func, " <- function(..., split_on) {
result <- format_args(..., split_on = split_on, func = landscapemetrics::", func, ")
return(result)
}
")}
#List Everything in LSM + Filter
funcs <- ls('package:landscapemetrics')
funcs <- funcs[!funcs %in% exclude]
#Format as Functions
funcs <- lapply(funcs, func_format)
#Write to File
funcs <- append(file_top, funcs)
writeLines(text = paste(funcs, collapse = '\n'), con = output_file)
usethis::use_test('parallel-lsm.R')
usethis::use_test('lsm-funcs.R')
