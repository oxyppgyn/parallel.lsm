#Function to Format Input Args + Run LSM Functions
format_args <- function(..., split_on, workers, func) {
args <- list(...)
#Validate Inputs
checkmate::assert_integerish(workers, lower = 2)
checkmate::assert_character(split_on)
checkmate::assert_function(func)
if (environmentName(environment(func)) != 'landscapemetrics') {stop(paste0(deparse(substitute(func)), '() is not a function in landscapemetrics.'))}
if (!all(split_on %in% names(args))) {stop('At least one variable specified in `split_on` is not present in the function call.')}
if (workers > parallelly::availableCores()) {stop('Number of workers is greater than the number of available cores.')}
#Seperate Out Split Args
split_args <- args[names(args) %in% split_on]
args <- args[!names(args) %in% split_on]
#Check that Split Args are Correct Length
for (arg in names(split_args)) {
if (length(split_args[[arg]]) != workers) {stop(paste0('Length of split variable `', split_args[[arg]], '` (', length(split_args[[arg]]), ') is different from the number of workers (', workers, ').'))}
}
#Wrap terra/raster Variables
##Note: does not account for lists of terra objects not in split_on
for (arg in names(args)) {
if (inherits(args[[arg]], c('SpatRaster', 'SpatVector'))) {
args[[arg]] <- terra::wrap(args[[arg]])
}
}
for (arg in names(split_args)) {
for (val in 1:length(split_args[[arg]])) {
if (inherits(split_args[[arg]][[val]], c('SpatRaster', 'SpatVector'))) {
split_args[[arg]][[val]] <- lapply(split_args[[arg]][[val]], terra::wrap)
}
}
}
#Reformat Split Args
split_args_names <- names(split_args)
split_args <- apply(do.call(rbind, split_args), 2, as.list, simplify = FALSE)
split_args <- lapply(split_args, function(x, names) setNames(x, names), names = split_args_names)
#return(split_args)
if (length(args) == 0) {
args <- NULL
}
#Set Plan
##Sequential first incase multisession already active/needs cleaned
future::plan(future::sequential)
future::plan(future::multisession, workers = workers)
on.exit(future::plan(future::sequential))
#Run LSM Function
result <- do.call(
future.apply::future_mapply,
args = list(
'FUN' = future_apply_lsm, #----------------------------------
'SIMPLIFY' = FALSE,
'split_args' = split_args,
'MoreArgs' = list('args' = args, 'func' = func, 'split_args_names' = split_args_names)
)
)
#Join Together Result
## Only done for tibbles
if (all(sapply(result, is.data.frame))) {
result <- do.call(dplyr::bind_rows, result)
} else {
print("A")
}
return(result)
}
#' Run `landscapemetrics` Functions in Parallel
#'
#' Runs a chosen `landscapemetrics` function across multiple processes at the same time.
#'
#' @param ... arguments passed to `func`.
#' @param func function. A function from the `landscapemetrics` metrics.
#' @param split_on character. Names of arguments in `...` to split between workers.
#' Multiple arguments can be specified. This is useful for instances such as splitting
#' sampling points between workers while also preserving plot_id values between all
#' processes.
#' @param workers numeric. The number of workers to use in parallel. Use
#' [parallelly::availableCores()] to check the number of total cores that can
#' be used. Large rasters/other objects can use up excessive RAM and may require
#' using fewer cores than are actually available. Best practice generally is to use
#' n - 1 or n - 2 cores regardless.
#' @return format varies based on `func`.
#' @export
parallel.lsm <- function(..., func, split_on, workers) {
result <- format_args(..., split_on = split_on, workers = workers, func = func)
return(result)
}
parallel.sample_lsm <- function(..., split_on, workers) {
func <- landscapemetrics::sample_lsm
result <- format_args(..., split_on = split_on, workers = workers, func = func)
return(result)
}
y <- parallel.lsm(landscape = x, directions = 8, func = lsm_l_area_cv, split_on = 'landscape', workers = 2)
View(y)
y <- parallel.lsm(landscape = x, directions = 8, func = lsm_l_area_cv, split_on = 'landscape', workers = 3)
